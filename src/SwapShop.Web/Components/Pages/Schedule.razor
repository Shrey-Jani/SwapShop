@page "/manager/schedule"

@using Position = SwapShop.Core.Enums.Position
@using Microsoft.AspNetCore.Authorization
@using SwapShop.Core.Enums
@using SwapShop.Core.Models
@using SwapShop.Core.Services
@using SwapShop.Core.Utilities
@using SwapShop.Web.Components.Dialogs

@attribute [Authorize(Roles = Roles.Manager)]

@inject IShiftService ShiftService
@inject IEmployeeService EmployeeService
@inject IConflictService ConflictService
@inject IDialogService DialogService

@inject ISnackbar Snackbar

<PageTitle>Schedule</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Schedule</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="loading"
                   OnClick="() => ChangeWeekAsync(-7)" />
    <MudText Typo="Typo.h6">@weekStart.ToString("MMM d") – @weekStart.AddDays(6).ToString("MMM d, yyyy")</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="loading"
                   OnClick="() => ChangeWeekAsync(7)" />
    <MudButton Variant="Variant.Text" Disabled="loading" OnClick="GoToThisWeekAsync">This week</MudButton>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="() => AddAsync(weekStart, null, null)">Add shift</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Success" Class="mr-2"
            StartIcon="@Icons.Material.Filled.Publish"
            Disabled="@(loading || DraftCount == 0)"
            OnClick="PublishWeekAsync">
            Publish week@(DraftCount > 0 ? $" ({DraftCount})" : "")
    </MudButton>
</MudStack>

@if (DraftCount > 0)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
        @DraftCount draft shift(s) this week are hidden from staff until you publish the week.
        Outlined chips are drafts, solid green chips are published.
    </MudAlert>
}

@if (conflicts.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
            <span>@conflicts.Count shift(s) have conflicts. Hover a shift to see why.</span>
            @foreach (var type in Enum.GetValues<ConflictType>().Where(t => CountWith(t) > 0))
            {
                <span><MudIcon Icon="@IconFor(type)" Size="Size.Small" /> @TypeText(type, CountWith(type))</span>
            }
        </MudStack>
    </MudAlert>
}

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-2" />
}

<div style="overflow-x: auto;">
    <MudSimpleTable Dense="true" Bordered="true">
        <thead>
            <tr>
                <th>Employee</th>
                @foreach (var day in Days)
                {
                    <th>@day.ToString("ddd d")</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <td><strong>@row.Name</strong></td>
                    @foreach (var day in Days)
                    {
                        <td>@Cell(row.Id, day, row.Position)</td>
                    }
                </tr>
            }
            <tr>
                <td><strong>Open shifts</strong></td>
                @foreach (var day in Days)
                {
                    <td>@Cell(null, day, null)</td>
                }
            </tr>
        </tbody>
    </MudSimpleTable>
</div>

@code {
    private record GridRow(string Id, string Name, Position? Position);

    private int DraftCount => shifts.Count(s => !s.IsPublished);

    private DateOnly weekStart = WeekHelper.StartOfWeek(DateOnly.FromDateTime(DateTime.Today));
    private IReadOnlyList<ShiftDto> shifts = [];
    private IReadOnlyDictionary<int, IReadOnlyList<Conflict>> conflicts = new Dictionary<int, IReadOnlyList<Conflict>>();
    private List<GridRow> rows = [];
    private bool loading = true;

    private IEnumerable<DateOnly> Days => Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;

        var employees = await EmployeeService.GetAllAsync(includeInactive: false);
        shifts = await ShiftService.GetWeekAsync(weekStart);
        conflicts = await ConflictService.GetWeekConflictsAsync(weekStart);

        rows = employees
            .Select(e => new GridRow(e.Id, e.FullName, e.Position))
            .ToList();

        var missing = shifts
            .Where(s => s.AssignedUserId is not null && rows.All(r => r.Id != s.AssignedUserId))
            .DistinctBy(s => s.AssignedUserId);

        foreach (var shift in missing)
        {
            rows.Add(new GridRow(shift.AssignedUserId!, $"{shift.AssignedUserName} (inactive)", null));
        }

        loading = false;
    }

    private async Task ChangeWeekAsync(int days)
    {
        weekStart = weekStart.AddDays(days);
        await LoadAsync();
    }

    private async Task GoToThisWeekAsync()
    {
        weekStart = WeekHelper.StartOfWeek(DateOnly.FromDateTime(DateTime.Today));
        await LoadAsync();
    }

    private IEnumerable<ShiftDto> ShiftsFor(string? userId, DateOnly day) =>
        shifts.Where(s => s.AssignedUserId == userId && s.Date == day);

    private IEnumerable<ConflictType> ConflictTypesFor(ShiftDto shift) =>
        conflicts.TryGetValue(shift.Id, out var list)
            ? list.Select(c => c.Type).Distinct()
            : [];

    private int CountWith(ConflictType type) =>
        conflicts.Values.Count(list => list.Any(c => c.Type == type));

    private string ChipTitle(ShiftDto shift) =>
        conflicts.TryGetValue(shift.Id, out var list)
            ? $"{shift.Position}" + string.Concat(list.Select(c => $"{Environment.NewLine}{TypeLabel(c.Type)}: {c.Message}"))
            : shift.Position.ToString();

    private static string IconFor(ConflictType type) => type switch
    {
        ConflictType.Overlap => Icons.Material.Filled.Layers,
        ConflictType.OutsideAvailability => Icons.Material.Filled.EventBusy,
        _ => Icons.Material.Filled.BeachAccess
    };

    private static string TypeLabel(ConflictType type) => type switch
    {
        ConflictType.Overlap => "Overlap",
        ConflictType.OutsideAvailability => "Availability",
        _ => "Time off"
    };

    private static string TypeText(ConflictType type, int count) => type switch
    {
        ConflictType.Overlap => $"{count} overlapping another shift",
        ConflictType.OutsideAvailability => $"{count} outside availability",
        _ => $"{count} on approved time off"
    };

    private RenderFragment Cell(string? userId, DateOnly day, Position? position) => @<div>
        @foreach (var shift in ShiftsFor(userId, day))
        {
            <MudChip T="string" Size="Size.Small"
                     Variant="@(shift.IsPublished ? Variant.Filled : Variant.Outlined)"
                     Color="@(shift.IsPublished ? Color.Success : Color.Default)"
                     title="@ChipTitle(shift)"
                     OnClick="() => EditAsync(shift.Id)">
                @foreach (var type in ConflictTypesFor(shift))
                {
                    <MudIcon Icon="@IconFor(type)" Size="Size.Small" Color="Color.Warning" Class="mr-1" />
                }
                @shift.StartTime.ToString("HH:mm")–@shift.EndTime.ToString("HH:mm")
                @if (userId is null)
                {
                    <text> · @shift.Position</text>
                }
            </MudChip>
        }
        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                       OnClick="() => AddAsync(day, userId, position)" />
    </div>;

    private Task AddAsync(DateOnly day, string? userId, Position? position)
    {
        var model = new ShiftFormModel { Date = day, AssignedUserId = userId };
        if (position is not null)
        {
            model.Position = position.Value;
        }

        return OpenDialogAsync("Add shift", model);
    }

    private async Task EditAsync(int id)
    {
        var model = await ShiftService.GetForEditAsync(id);
        if (model is null)
        {
            return;
        }

        await OpenDialogAsync("Edit shift", model);
    }

    private async Task OpenDialogAsync(string title, ShiftFormModel model)
    {
        var parameters = new DialogParameters<ShiftDialog> { { x => x.Model, model } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<ShiftDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

        private async Task PublishWeekAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Publish week",
            $"Publish {DraftCount} draft shift(s) for {weekStart:MMM d} – {weekStart.AddDays(6):MMM d}? Staff will be able to see them.",
            yesText: "Publish",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        loading = true;
        var published = await ShiftService.PublishWeekAsync(weekStart);

        Snackbar.Add($"Published {published} shift(s).", Severity.Success);
        await LoadAsync();
    }
}