@page "/manager/employees"

@using Microsoft.AspNetCore.Authorization
@using SwapShop.Core.Models
@using SwapShop.Core.Services

@attribute [Authorize(Roles = Roles.Manager)]

@inject IEmployeeService EmployeeService

<PageTitle>Employees</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Employees</MudText>

<MudSwitch T="bool" @bind-Value="showInactive" @bind-Value:after="LoadAsync" Color="Color.Primary" Label="Show inactive" />

<MudTable Items = "employees" Loading="loading" Hover="true" Striped="true" Dense="true">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Position</MudTh>
        <MudTh>Hourly rate</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.FullName</MudTd>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Position">@context.Position</MudTd>
        <MudTd DataLabel="Hourly rate">@context.HourlyRate.ToString("C")
</MudTd>
    <MudTd DataLabel="Status">
        <MudChip T="String" Size="Size.Small"
            Color="@(context.IsActive ? Color.Success : Color.Default)">
            @(context.IsActive ? "Active" : "Inactive")
            </MudChip>
    </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No employees found.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private IReadOnlyList<EmployeeDto> employees = [];
    private bool loading = true;
    private bool showInactive = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        employees = await EmployeeService.GetAllAsync(showInactive);
        loading = false;
    }
}